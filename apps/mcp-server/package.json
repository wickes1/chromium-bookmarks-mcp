{
  "name": "chromium-bookmarks-mcp",
  "version": "0.2.0",
  "description": "MCP server for real-time Chromium browser bookmark management. Works with Brave, Chrome, Edge, Arc.",
  "type": "module",
  "license": "MIT",
  "author": "Wickes1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wickes1/chromium-bookmarks-mcp"
  },
  "keywords": [
    "mcp",
    "bookmarks",
    "chrome",
    "brave",
    "chromium",
    "model-context-protocol",
    "ai-agent",
    "browser-extension",
    "claude"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "chromium-bookmarks-mcp": "dist/index.js"
  },
  "files": [
    "dist/**",
    "bin/**",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/native-host.ts --target=bun --outdir=dist --external @modelcontextprotocol/sdk --external zod",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@chromium-bookmarks-mcp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
